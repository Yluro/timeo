timeo{
  gui{
    location = 'tools'
      .type = str
      .help = The tab item where the Timeo GUI shall appear.
    before = 'images'
      .type = str
      .help = The tool before which the Timeo GUI shall appear.
  }
  merge_ligands = False
    .type = bool
    .help = Merge pi-bonded ligands into their centroid before measuring.
  exclude_h = False
    .type = bool
    .help = Leave hydrogen and deuterium atoms out of the coordination polyhedron.
  part_codes = ''
    .type = str
    .help = Space-separated disorder part codes, each measured as one structure. Every digit of a code is a part: "01 02" measures parts 0+1 and 0+2, "34" parts 3+4, "0" part 0 only. Leave empty to measure part 0 with each other part.
  check_for_updates = True
    .type = bool
    .help = Check GitHub once a day for a newer Timeo release and say so in the console.

  shape{
    exe_path = ''
      .type = str
      .help = Explicit path to the SHAPE executable. Leave empty to search PATH.
  }

  overlay{
    opacity = 35
      .type = int(value_min=0, value_max=100)
      .help = Face opacity in percent. 0 draws only the edges and vertices.
    edges = True
      .type = bool
      .help = Draw the polyhedron edges.
    markers = True
      .type = bool
      .help = Draw small spheres at the ideal vertex positions.
    colour_by = 'shape'
      .type = str
      .help = Colour by shape (one colour per shape), centre (one colour per run) or element (the colour Olex2 draws the central atom in).
  }

  cosmochlore{
    exe_path = ''
      .type = str
      .help = Explicit path to the cosmochlore executable. Leave empty to search PATH.
    cshm{
      table = False
        .type = bool
        .help = Write a _cshm_table.csv file next to the .xyz.
      ideal = False
        .type = bool
        .help = Write a _ideal.xyz file with the reconstructed reference shapes.
    }
    csom{
      point_groups = ''
        .type = str
        .help = Default space-separated point groups for autoCSOM(), e.g. "Oh D4h D3d".
      mode = 'auto'
        .type = str
        .help = Default centering mode for autoCSOM() (auto, first, centroid, manual).
      vector = ''
        .type = str
        .help = Manual centering vector "x y z" (space-separated), used only when mode = manual.
      full = False
        .type = bool
        .help = Write a per-operation _details.csv file for each point group.
      table = False
        .type = bool
        .help = Write a _csom_table.csv summary file.
      operated = False
        .type = bool
        .help = Write operated .xyz/.mol2 files showing each symmetry operation applied.
      ignore_labels = False
        .type = bool
        .help = Ignore atom labels when matching atoms between structures.
      seeds = 20
        .type = int(value_min=1, value_max=1000)
        .help = Number of candidate symmetry-axis directions (Fibonacci hemisphere) that seed the csom axis search. The cosmochlore default is 20.
      iterations = 200
        .type = int(value_min=1, value_max=10000)
        .help = Maximum number of Nelder-Mead iterations spent refining each seed. The cosmochlore default is 200.
      tolerance_exponent = 6
        .type = int(value_min=1, value_max=15)
        .help = Convergence tolerance of the Nelder-Mead refinement as a power of ten, N meaning 1e-N. The cosmochlore default is 6 (1e-6).
    }
    odis{
      full = False
        .type = bool
        .help = Also compute CShM (OC-6/TPR-6) and CSoM against common octahedral distortions.
      table = False
        .type = bool
        .help = Write a _odis_table.csv file next to the .xyz.
    }
  }
}
